# 复制为 .env 后填入自己的密钥：cp .env.example .env
# .env 已被 .gitignore 排除，密钥不会进仓库。已存在的环境变量优先于本文件。

# ===== 大模型（意图理解 / 复合指令规划 / 语义反诈信号）=====
# 默认 DeepSeek。换通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
# 换本地 Ollama：http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 讯飞在线语音合成（可选，不配则用浏览器语音合成）=====
XFYUN_APP_ID=
XFYUN_TTS_KEY=
XFYUN_TTS_SECRET=
XFYUN_TTS_VCN=xiaoyan

# ===== 讯飞语音听写（可选，仅 POST /asr 接口使用）=====
XFYUN_API_KEY=
XFYUN_API_SECRET=
